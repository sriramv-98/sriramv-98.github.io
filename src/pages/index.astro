---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const experience = [
  {
    role: 'Software Dev Engineer, Financial Risk Mitigation',
    org: 'Amazon',
    period: 'August 2025 - Present',
    description:
      'Designing and building low latency, highly available backend services to prevent bad actors from taking advantage of Amazon and preventing bad debt.',
  },
  {
    role: 'Software Engineer II',
    org: 'Cisco',
    period: 'August 2020 - July 2023',
    description:
      'Full stack developer building applications on the Angular-Spring Boot tech stack catering to HR use cases, with a focus on data privacy and secure handling of employee information.',
  },
];

const education = [
  {
    school: 'University of Southern California',
    degree: 'Master of Science',
    field: 'Computer Science',
    period: 'August 2023 - May 2025',
  },
  {
    school: 'The National Institute of Engineering, India',
    degree: 'Bachelor of Engineering',
    field: 'Information Science & Engineering',
    period: 'August 2016 - August 2020',
  },
];
---

<Layout
  title="Home"
  description="Sriram Venkatesh — software engineer at Amazon, sharing weekly learnings and building things."
>
  <Nav />

  <main class="mx-auto max-w-4xl px-6">
    <!-- Hero / About -->
    <section id="about" class="flex min-h-[70vh] flex-col justify-center py-20">
      <h1 class="font-display text-4xl font-bold uppercase tracking-tight text-black sm:text-6xl">
        Sriram Venkatesh
      </h1>
      <p class="mt-3 inline-block w-fit border-2 border-black bg-white px-2 py-0.5 text-sm font-semibold uppercase">
        Seattle, WA
      </p>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-black">
        Software engineer at Amazon, building distributed systems. Master's in Computer
        Science from USC, with prior experience across Amazon, Wayfair, and Cisco.
      </p>

      <!--
        TODO (Sriram): Add a paragraph here describing what this website is about
        (portfolio + weekly learnings blog). Replace the placeholder <p> below.
      -->
      <p class="shadow-brutal-sm mt-6 max-w-2xl border-2 border-black bg-white p-4 text-black/40 italic">
        [Add your paragraph about what this website is here.]
      </p>

      <div class="mt-8 flex items-center gap-4">
        <a
          href="https://www.linkedin.com/in/sriram-venkatesh98/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="shadow-brutal-sm flex h-11 w-11 items-center justify-center border-2 border-black bg-white text-black transition-transform hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.114 20.452H3.558V9h3.556v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a
          href="https://github.com/sriramv-98"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="shadow-brutal-sm flex h-11 w-11 items-center justify-center border-2 border-black bg-white text-black transition-transform hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.333-1.754-1.333-1.754-1.089-.744.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.303-5.466-1.332-5.466-5.93 0-1.31.469-2.38 1.236-3.22-.124-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.301 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.047.138 3.006.404 2.29-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.873.118 3.176.77.84 1.235 1.91 1.235 3.22 0 4.61-2.807 5.624-5.48 5.921.43.372.823 1.102.823 2.222 0 1.604-.014 2.896-.014 3.286 0 .32.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
        </a>
        <a
          href="/blog"
          class="shadow-brutal border-2 border-black bg-black px-5 py-2.5 text-sm font-bold uppercase tracking-wide text-[#f4f2ea] transition-transform hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none"
        >
          Read the blog
        </a>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="py-16">
      <h2 class="font-display inline-block border-2 border-black bg-white px-3 py-1 text-2xl font-bold uppercase">
        Experience
      </h2>
      <div class="mt-8 space-y-6">
        {experience.map((item) => (
          <div class="shadow-brutal flex flex-col justify-between gap-2 border-2 border-black bg-white p-6 sm:flex-row sm:gap-8">
            <div>
              <h3 class="text-lg font-bold text-black">{item.role}</h3>
              <p class="font-semibold text-black/70">{item.org}</p>
              <p class="mt-2 max-w-2xl text-black/80">{item.description}</p>
            </div>
            <p class="whitespace-nowrap border-2 border-black bg-[#f4f2ea] px-2 py-1 text-xs font-bold uppercase sm:text-right">
              {item.period}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section id="education" class="py-16">
      <h2 class="font-display inline-block border-2 border-black bg-white px-3 py-1 text-2xl font-bold uppercase">
        Education
      </h2>
      <div class="mt-8 space-y-6">
        {education.map((item) => (
          <div class="shadow-brutal flex flex-col justify-between gap-2 border-2 border-black bg-white p-6 sm:flex-row sm:gap-8">
            <div>
              <h3 class="text-lg font-bold text-black">{item.school}</h3>
              <p class="font-semibold text-black/70">{item.degree}</p>
              <p class="text-black/80">{item.field}</p>
            </div>
            <p class="whitespace-nowrap border-2 border-black bg-[#f4f2ea] px-2 py-1 text-xs font-bold uppercase sm:text-right">
              {item.period}
            </p>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
