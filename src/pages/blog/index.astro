---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Blog"
  description="Weekly learnings and notes from Sriram Venkatesh."
>
  <Nav />

  <main class="mx-auto max-w-4xl px-6 py-16">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Blog</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      A weekly log of things I'm learning and building.
    </p>

    <div class="mt-10 space-y-8">
      {posts.length === 0 && (
        <p class="text-slate-400 italic">No posts yet — the first one is coming soon.</p>
      )}
      {posts.map((post) => (
        <a href={`/blog/${post.id}/`} class="block group">
          <h2 class="text-xl font-semibold text-slate-900 group-hover:text-indigo-600">
            {post.data.title}
          </h2>
          <p class="mt-1 text-sm text-slate-500">
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </p>
          <p class="mt-2 text-slate-600">{post.data.description}</p>
        </a>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
