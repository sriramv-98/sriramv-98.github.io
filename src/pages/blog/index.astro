---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Blog"
  description="Weekly learnings and notes from Sriram Venkatesh."
>
  <Nav />

  <main class="mx-auto max-w-4xl px-6 py-16">
    <h1 class="font-display inline-block border-2 border-black bg-white px-3 py-1 text-3xl font-bold uppercase">
      Blog
    </h1>
    <p class="mt-4 max-w-2xl text-black/80">
      A weekly log of things I'm learning and building.
    </p>

    <div class="mt-10 space-y-6">
      {posts.length === 0 && (
        <p class="shadow-brutal-sm border-2 border-dashed border-black/40 bg-white p-6 text-black/50 italic">
          No posts yet — the first one is coming soon.
        </p>
      )}
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}/`}
          class="shadow-brutal group block border-2 border-black bg-white p-6 transition-transform hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none"
        >
          <h2 class="text-xl font-bold text-black">
            {post.data.title}
          </h2>
          <p class="mt-1 text-xs font-bold uppercase text-black/50">
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </p>
          <p class="mt-2 text-black/80">{post.data.description}</p>
        </a>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
