---
const links = [
  { href: '/', label: 'Home' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#education', label: 'Education' },
  { href: '/blog', label: 'Blog' },
];
---

<header class="sticky top-0 z-50 border-b-2 border-black bg-[#f4f2ea]">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
    <a href="/" class="font-display text-lg font-bold uppercase tracking-tight text-black">
      Sriram Venkatesh
    </a>
    <ul class="flex items-center gap-1 text-sm font-semibold uppercase tracking-wide text-black">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="inline-block border-2 border-transparent px-3 py-1.5 transition-colors hover:border-black hover:bg-accent"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
