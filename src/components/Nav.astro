---
const links = [
  { href: '/', label: 'Home' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#education', label: 'Education' },
  { href: '/blog', label: 'Blog' },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
    <a href="/" class="text-lg font-bold tracking-tight text-slate-900">
      Sriram Venkatesh
    </a>
    <ul class="flex items-center gap-6 text-sm font-medium text-slate-600">
      {links.map((link) => (
        <li>
          <a href={link.href} class="transition-colors hover:text-slate-900">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
